# このファイルをコピーして .env を作り、Neon の接続文字列を入れる（.env はコミットしない）
#   cp .env.example .env
#
# Neon のダッシュボード → Connect で表示される接続文字列を使う。

# アプリから使う接続（Connection pooling を ON にした「-pooler」付きのホスト）
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# マイグレーション用の直接接続（Connection pooling を OFF にした「-pooler」なしのホスト）
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ログイン（next-auth）のセッションの署名・暗号化に使う秘密の鍵。次のコマンドで作った値を入れる
#   openssl rand -base64 33
# 本番（Vercel など）では、環境変数に別の値を設定する
# Vercel 以外で next start するときは、次の行も入れる
# AUTH_TRUST_HOST=true
AUTH_SECRET="ここに秘密の鍵を入れる"
